{
    "manifest_version": 3,

    "name": "时间",
    "description": "时间都去哪儿了。",
    "version": "1.20.1.4",

    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },

    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },

    "action": {
        "default_icon": {
            "16": "images/icon16.png",
            "24": "images/icon24.png",
            "32": "images/icon32.png"
        },
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "event.js"
    },

    "permissions": [
        "tabs",
        "alarms",
        "idle",
        "storage",
        "unlimitedStorage"
    ]
}
